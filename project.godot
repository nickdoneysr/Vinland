; Engine configuration file.
config_version=5

[application]

config/name="Vinland"
config/description="Oregon Trail structure on the Karlsefni voyage. Gamepad-first."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Knobs="*res://scripts/autoload/knobs.gd"
Art="*res://scripts/autoload/art.gd"
Controls="*res://scripts/autoload/controls.gd"
Game="*res://scripts/autoload/game.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
